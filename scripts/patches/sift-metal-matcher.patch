+size_t FindBestMatchesOneWayTop2(const std::vector<int>& best_idx,
+                                 const std::vector<float>& best_dot,
+                                 const std::vector<float>& second_dot,
+                                 const float max_ratio,
+                                 const float max_distance,
+                                 std::vector<int>* matches) {
+  constexpr float kInvSqDescriptorNorm =
+      static_cast<float>(1. / kSqSiftDescriptorNorm);
+
+  size_t num_matches = 0;
+  matches->assign(best_idx.size(), -1);
+
+  for (size_t i1 = 0; i1 < best_idx.size(); ++i1) {
+    if (best_idx[i1] < 0) {
+      continue;
+    }
+
+    const float best_dist_normed =
+        std::acos(std::min(kInvSqDescriptorNorm * best_dot[i1], 1.0f));
+    if (best_dist_normed > max_distance) {
+      continue;
+    }
+
+    const float second_best_dist_normed = std::acos(
+        std::min(kInvSqDescriptorNorm * second_dot[i1], 1.0f));
+    if (best_dist_normed >= max_ratio * second_best_dist_normed) {
+      continue;
+    }
+
+    ++num_matches;
+    (*matches)[i1] = best_idx[i1];
+  }
+
+  return num_matches;
+}
