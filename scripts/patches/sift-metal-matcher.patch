diff --git a/src/thirdparty/SiftMetal/SiftMetalMatch.h b/src/thirdparty/SiftMetal/SiftMetalMatch.h
new file mode 100644
index 00000000..f3bd03f0
--- /dev/null
+++ b/src/thirdparty/SiftMetal/SiftMetalMatch.h
@@ -0,0 +1,36 @@
+// Metal brute-force SIFT matcher: uint8 descriptor dots, top-2 per query.
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace sift_metal {
+
+class SiftMetalMatcherImpl;
+
+class SiftMetalMatcher {
+ public:
+  SiftMetalMatcher();
+  ~SiftMetalMatcher();
+
+  SiftMetalMatcher(const SiftMetalMatcher&) = delete;
+  SiftMetalMatcher& operator=(const SiftMetalMatcher&) = delete;
+
+  // Loads sift.metallib and the match kernel. False if Metal is unavailable.
+  bool Init();
+
+  // One-way top-2 dots. `queries`/`index` are row-major n×128 / m×128 uint8.
+  bool Top2(int num_queries,
+            const uint8_t* queries,
+            int num_index,
+            const uint8_t* index,
+            std::vector<int>* best_idx,
+            std::vector<float>* best_dot,
+            std::vector<float>* second_dot);
+
+ private:
+  std::unique_ptr<SiftMetalMatcherImpl> impl_;
+};
+
+}  // namespace sift_metal
diff --git a/src/thirdparty/SiftMetal/SiftMetalMatch.mm b/src/thirdparty/SiftMetal/SiftMetalMatch.mm
new file mode 100644
index 00000000..688c6d4b
--- /dev/null
+++ b/src/thirdparty/SiftMetal/SiftMetalMatch.mm
@@ -0,0 +1,238 @@
+// SiftMetalMatch.mm - Metal brute-force SIFT descriptor matching.
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+#include "SiftMetalMatch.h"
+
+#include <cstring>
+#include <limits.h>
+#include <mach-o/dyld.h>
+#include <stdlib.h>
+#include <string>
+#include <vector>
+
+#ifndef SIFT_METAL_METALLIB_PATH
+#define SIFT_METAL_METALLIB_PATH ""
+#endif
+
+namespace sift_metal {
+namespace {
+
+constexpr int kDescriptorDim = 128;
+
+NSString* ExecutableDirectory() {
+  uint32_t size = 0;
+  _NSGetExecutablePath(nullptr, &size);
+  std::vector<char> buf(size > 0 ? size : 1);
+  if (_NSGetExecutablePath(buf.data(), &size) != 0) {
+    return nil;
+  }
+  char resolved[PATH_MAX];
+  const char* path = buf.data();
+  if (realpath(path, resolved) != nullptr) {
+    path = resolved;
+  }
+  return [[NSString stringWithUTF8String:path]
+      stringByDeletingLastPathComponent];
+}
+
+id<MTLLibrary> LoadMetallib(id<MTLDevice> device, NSError** error) {
+  NSMutableArray<NSString*>* candidates = [NSMutableArray array];
+  NSString* exeDir = ExecutableDirectory();
+  if (exeDir.length > 0) {
+    [candidates addObject:[exeDir stringByAppendingPathComponent:@"sift.metallib"]];
+    [candidates addObject:[exeDir
+        stringByAppendingPathComponent:@"colmap-libs/sift.metallib"]];
+    [candidates addObject:[[exeDir
+        stringByAppendingPathComponent:@"../Resources/colmap-libs/sift.metallib"]
+        stringByStandardizingPath]];
+  }
+  const char* baked = SIFT_METAL_METALLIB_PATH;
+  if (baked != nullptr && baked[0] != '\0') {
+    [candidates addObject:[NSString stringWithUTF8String:baked]];
+  }
+  for (NSString* path in candidates) {
+    if (![[NSFileManager defaultManager] fileExistsAtPath:path]) {
+      continue;
+    }
+    id<MTLLibrary> library =
+        [device newLibraryWithURL:[NSURL fileURLWithPath:path] error:error];
+    if (library) {
+      return library;
+    }
+  }
+  return [device newDefaultLibrary];
+}
+
+id<MTLBuffer> SharedBuffer(id<MTLDevice> device, NSUInteger bytes) {
+  return [device newBufferWithLength:bytes
+                             options:MTLResourceStorageModeShared];
+}
+
+}  // namespace
+
+class SiftMetalMatcherImpl {
+ public:
+  bool Init();
+  bool Top2(int num_queries,
+            const uint8_t* queries,
+            int num_index,
+            const uint8_t* index,
+            std::vector<int>* best_idx,
+            std::vector<float>* best_dot,
+            std::vector<float>* second_dot);
+
+ private:
+  bool EnsureCapacity(int num_queries, int num_index);
+
+  id<MTLDevice> device_ = nil;
+  id<MTLCommandQueue> commandQueue_ = nil;
+  id<MTLComputePipelineState> pipeline_ = nil;
+  id<MTLBuffer> queries_ = nil;
+  id<MTLBuffer> index_ = nil;
+  id<MTLBuffer> bestIdx_ = nil;
+  id<MTLBuffer> bestDot_ = nil;
+  id<MTLBuffer> secondDot_ = nil;
+  int query_cap_ = 0;
+  int index_cap_ = 0;
+};
+
+bool SiftMetalMatcherImpl::Init() {
+  device_ = MTLCreateSystemDefaultDevice();
+  if (!device_) {
+    return false;
+  }
+  commandQueue_ = [device_ newCommandQueue];
+  if (!commandQueue_) {
+    return false;
+  }
+  NSError* error = nil;
+  id<MTLLibrary> library = LoadMetallib(device_, &error);
+  if (!library) {
+    NSLog(@"SiftMetalMatch: Failed to load Metal library: %@", error);
+    return false;
+  }
+  id<MTLFunction> fn = [library newFunctionWithName:@"sift_match_top2"];
+  if (!fn) {
+    NSLog(@"SiftMetalMatch: kernel sift_match_top2 missing from metallib");
+    return false;
+  }
+  pipeline_ = [device_ newComputePipelineStateWithFunction:fn error:&error];
+  if (!pipeline_) {
+    NSLog(@"SiftMetalMatch: Failed to create pipeline: %@", error);
+    return false;
+  }
+  return true;
+}
+
+bool SiftMetalMatcherImpl::EnsureCapacity(int num_queries, int num_index) {
+  if (num_queries > query_cap_) {
+    queries_ = SharedBuffer(device_,
+                            static_cast<NSUInteger>(num_queries) * kDescriptorDim);
+    bestIdx_ =
+        SharedBuffer(device_, static_cast<NSUInteger>(num_queries) * sizeof(int));
+    bestDot_ =
+        SharedBuffer(device_, static_cast<NSUInteger>(num_queries) * sizeof(float));
+    secondDot_ =
+        SharedBuffer(device_, static_cast<NSUInteger>(num_queries) * sizeof(float));
+    if (!queries_ || !bestIdx_ || !bestDot_ || !secondDot_) {
+      return false;
+    }
+    query_cap_ = num_queries;
+  }
+  if (num_index > index_cap_) {
+    index_ = SharedBuffer(device_,
+                          static_cast<NSUInteger>(num_index) * kDescriptorDim);
+    if (!index_) {
+      return false;
+    }
+    index_cap_ = num_index;
+  }
+  return true;
+}
+
+bool SiftMetalMatcherImpl::Top2(int num_queries,
+                                const uint8_t* queries,
+                                int num_index,
+                                const uint8_t* index,
+                                std::vector<int>* best_idx,
+                                std::vector<float>* best_dot,
+                                std::vector<float>* second_dot) {
+  best_idx->assign(num_queries, -1);
+  best_dot->assign(num_queries, 0.f);
+  second_dot->assign(num_queries, 0.f);
+  if (num_queries == 0) {
+    return true;
+  }
+  if (num_index == 0) {
+    return true;
+  }
+  if (!EnsureCapacity(num_queries, num_index)) {
+    return false;
+  }
+
+  std::memcpy(queries_.contents, queries,
+              static_cast<size_t>(num_queries) * kDescriptorDim);
+  std::memcpy(index_.contents, index,
+              static_cast<size_t>(num_index) * kDescriptorDim);
+
+  uint32_t n_queries = static_cast<uint32_t>(num_queries);
+  uint32_t n_index = static_cast<uint32_t>(num_index);
+
+  id<MTLCommandBuffer> cb = [commandQueue_ commandBuffer];
+  id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoder];
+  [enc setComputePipelineState:pipeline_];
+  [enc setBuffer:queries_ offset:0 atIndex:0];
+  [enc setBuffer:index_ offset:0 atIndex:1];
+  [enc setBuffer:bestIdx_ offset:0 atIndex:2];
+  [enc setBuffer:bestDot_ offset:0 atIndex:3];
+  [enc setBuffer:secondDot_ offset:0 atIndex:4];
+  [enc setBytes:&n_queries length:sizeof(n_queries) atIndex:5];
+  [enc setBytes:&n_index length:sizeof(n_index) atIndex:6];
+
+  const NSUInteger width = pipeline_.threadExecutionWidth;
+  MTLSize threads = MTLSizeMake(static_cast<NSUInteger>(num_queries), 1, 1);
+  MTLSize groups = MTLSizeMake(width, 1, 1);
+  [enc dispatchThreads:threads threadsPerThreadgroup:groups];
+  [enc endEncoding];
+  [cb commit];
+  [cb waitUntilCompleted];
+  if (cb.error) {
+    NSLog(@"SiftMetalMatch: GPU command failed: %@", cb.error);
+    return false;
+  }
+
+  std::memcpy(best_idx->data(), bestIdx_.contents,
+              static_cast<size_t>(num_queries) * sizeof(int));
+  std::memcpy(best_dot->data(), bestDot_.contents,
+              static_cast<size_t>(num_queries) * sizeof(float));
+  std::memcpy(second_dot->data(), secondDot_.contents,
+              static_cast<size_t>(num_queries) * sizeof(float));
+  return true;
+}
+
+SiftMetalMatcher::SiftMetalMatcher()
+    : impl_(std::make_unique<SiftMetalMatcherImpl>()) {}
+
+SiftMetalMatcher::~SiftMetalMatcher() = default;
+
+bool SiftMetalMatcher::Init() { return impl_->Init(); }
+
+bool SiftMetalMatcher::Top2(int num_queries,
+                            const uint8_t* queries,
+                            int num_index,
+                            const uint8_t* index,
+                            std::vector<int>* best_idx,
+                            std::vector<float>* best_dot,
+                            std::vector<float>* second_dot) {
+  return impl_->Top2(num_queries,
+                     queries,
+                     num_index,
+                     index,
+                     best_idx,
+                     best_dot,
+                     second_dot);
+}
+
+}  // namespace sift_metal
diff --git a/src/thirdparty/SiftMetal/shaders/SiftMatch.metal b/src/thirdparty/SiftMetal/shaders/SiftMatch.metal
new file mode 100644
index 00000000..938d1ee1
--- /dev/null
+++ b/src/thirdparty/SiftMetal/shaders/SiftMatch.metal
@@ -0,0 +1,45 @@
+#include <metal_stdlib>
+using namespace metal;
+
+// One thread per query descriptor. Exact uint8 dot product vs all index rows,
+// keeping the top-2 scores for Lowe's ratio test on the CPU.
+kernel void sift_match_top2(device const uchar* queries [[buffer(0)]],
+                            device const uchar* index [[buffer(1)]],
+                            device int* best_idx [[buffer(2)]],
+                            device float* best_dot [[buffer(3)]],
+                            device float* second_dot [[buffer(4)]],
+                            constant uint& n_queries [[buffer(5)]],
+                            constant uint& n_index [[buffer(6)]],
+                            uint gid [[thread_position_in_grid]]) {
+  if (gid >= n_queries) {
+    return;
+  }
+
+  constexpr uint kDim = 128;
+  const device uchar* query = queries + gid * kDim;
+  float best = 0.0f;
+  float second = 0.0f;
+  int best_j = -1;
+
+  for (uint j = 0; j < n_index; ++j) {
+    const device uchar* row = index + j * kDim;
+    float acc = 0.0f;
+    for (uint k = 0; k < kDim; k += 4) {
+      acc += float(query[k]) * float(row[k]) +
+             float(query[k + 1]) * float(row[k + 1]) +
+             float(query[k + 2]) * float(row[k + 2]) +
+             float(query[k + 3]) * float(row[k + 3]);
+    }
+    if (acc > best) {
+      second = best;
+      best = acc;
+      best_j = int(j);
+    } else if (acc > second) {
+      second = acc;
+    }
+  }
+
+  best_idx[gid] = best_j;
+  best_dot[gid] = best;
+  second_dot[gid] = second;
+}
