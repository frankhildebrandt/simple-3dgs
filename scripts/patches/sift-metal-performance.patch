+// Index of the octave sigma closest to `sigma`.
+static int ClosestScaleIndex(const std::vector<float>& sigmas, float sigma) {
+  int scaleIdx = 0;
+  float bestDiff = 1e30f;
+  for (int s = 0; s < (int)sigmas.size(); ++s) {
+    float diff = std::abs(sigmas[s] - sigma);
+    if (diff < bestDiff) {
+      bestDiff = diff;
+      scaleIdx = s;
+    }
+  }
+  return scaleIdx;
+}
